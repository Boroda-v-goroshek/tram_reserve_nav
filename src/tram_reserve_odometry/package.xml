<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tram_reserve_odometry</name>
  <version>0.1.0</version>
  <description>
    Резервная (запасная) одометрия трамвая. Оценивает продольную скорость и
    положение по скоростям колёс передней/задней тележки и команде положения
    машиниста; положение ведётся вдоль 1D-карты маршрута и публикуется для
    base_link в MGRS. GNSS — для начальной выставки и коррекции положения.
    Алгоритмы — плагины pluginlib. В пакет также входят офлайн-прогон по bag,
    отрисовка карты в rviz2 и документация.
  </description>
  <maintainer email="dev@todo.todo">tram reserve odometry</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ рантайм -->
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tram_vehicle_msgs</depend>
  <depend>ament_index_cpp</depend>
  <!-- офлайн-прогон ноды по bag (reserve_odometry_replay) -->
  <depend>rosbag2_cpp</depend>

  <!-- Python-инструменты (отрисовка карты в rviz2) -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_default_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
