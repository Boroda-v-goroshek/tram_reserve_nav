<?xml version="1.0"?>
<package format="3">
  <name>hackathon_solution_checker</name>
  <version>0.1.0</version>
  <description>Online metrics for the localization hackathon solutions.</description>
  <maintainer email="maintainer@example.com">Hackathon maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>message_filters</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tram_vehicle_msgs</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
